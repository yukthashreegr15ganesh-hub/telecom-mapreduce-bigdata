# ====================================================================
# TELECOM MAPREDUCE GITIGNORE CONFIGURATION
# ====================================================================

# Large Datasets & Processed Partitions (Must NEVER be committed to Git)
data/raw/
data/processed/
*.part
*.tsv
*.tar.gz
*.txt.gz

# Preserve Sample Dataset & Manifest
!data/sample/sms-call-internet-mi-sample.txt
!data/metadata/download_manifest.csv
!data/metadata/dataset_metadata.json

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Streamlit Local Runtime
.streamlit/*
!.streamlit/config.toml

# Firebase CLI Cache
.firebase/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Hadoop Runtime, Execution Logs & Temporary Files
*.log
*.out
*.pid
/var/hadoop/
/var/log/hadoop/
tmp/
temp/
